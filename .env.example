# Copy this file to .env and fill in whichever keys you have.
# Luna runs fine with just ONE provider configured — she just has fewer
# "voices" available until you add more. Ollama needs no key at all.

PORT=3131

# Groq — free tier, very fast, hosts Llama/Gemma/etc.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (AI Studio) — free tier for Flash models.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — one key, many models (several genuinely free).
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama — fully local, zero cost, no key needed.
# Install: https://ollama.com  then e.g. `ollama pull llama3.2`
# Only change this if Ollama runs somewhere other than localhost.
OLLAMA_HOST=http://localhost:11434

# 9Router — local proxy that routes through 40+ free/cheap providers with
# automatic fallback. Run it first: `npm install -g 9router && 9router`
# (opens a dashboard at http://localhost:20128/dashboard), connect a
# provider there, then paste the dashboard's API key below.
# List available models with the key set: `curl localhost:20128/v1/models`
ROUTER9_BASE_URL=http://localhost:20128/v1
ROUTER9_API_KEY=
ROUTER9_MODEL=cc/claude-haiku-4-5-20251001
